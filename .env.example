# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# PostgreSQL (Docker Compose)
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="_____CHANGE_ME_____"
POSTGRES_DB="wgotalent"
POSTGRES_PORT="5432"

# Drizzle
DATABASE_URL="postgresql://postgres:_____CHANGE_ME_____@localhost:5432/wgotalent"

# Storage
STORAGE_ROOT="./storage"

# ── Produção (docker-compose.prod.yml) ──────────────────────────────────────
# No servidor, o .env deve ter chmod 600 e NUNCA entra na imagem Docker
# (ver .dockerignore); os containers o recebem em runtime via env_file.
# Valores de produção diferem dos de dev acima:
#   DATABASE_URL="postgresql://postgres:<senha-forte>@postgres:5432/wgotalent"
#     (host `postgres` = nome do serviço na rede interna do Compose)
#   STORAGE_ROOT="/app/storage"
#     (ponto de montagem do volume wgotalent_storage dentro do container)
#
# Porta do app exposta no host (vinculada a 127.0.0.1 — não pública).
# O Nginx Proxy Manager aponta para http://127.0.0.1:<APP_PORT>.
# Escolha uma porta livre na VPS; padrão 3000.
# APP_PORT=3000

# Backup (opcional; lido pelo cron que chama infra/backup/backup.sh)
# BACKUP_RETENTION_DAYS="14"
# BACKUP_RCLONE_REMOTE="b2:wgotalent-backups"

# Motor de Agentes IA (ADR-0007) — chave mestra usada para cifrar/decifrar
# credenciais de provedor LLM em repouso (AES-256-GCM). Gere uma vez com
# `openssl rand -base64 32` e nunca a rotacione sem um plano de re-cifragem
# das credenciais já salvas — rotacionar sem isso torna toda credencial
# existente ilegível.
AGENT_CREDENTIALS_ENCRYPTION_KEY="_____CHANGE_ME_____"
