# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# PostgreSQL (Docker Compose)
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="password"
POSTGRES_DB="wgotalent"
POSTGRES_PORT="5432"

# Drizzle
DATABASE_URL="postgresql://postgres:password@localhost:5432/wgotalent"

# Webhooks (Shared secret for N8N integration)
WEBHOOK_N8N_SECRET="your-n8n-webhook-shared-secret-here"

# Storage
STORAGE_ROOT="./storage"

# n8n (Docker Compose) — ver docs/decisions/0006-n8n-docker-compose-service.md
N8N_PORT="5678"
N8N_BASIC_AUTH_USER="admin"
N8N_BASIC_AUTH_PASSWORD="changeme"
GENERIC_TIMEZONE="America/Sao_Paulo"

# Disparo outbound para o n8n Classificador (ver docs/decisions/0005-outbound-classifier-trigger.md)
# Enquanto a app roda no host (fora do Compose): aponta para a porta publicada do n8n.
# Quando a app entrar no Compose (Fase 19): trocar para "http://n8n:5678/webhook/classificador".
CLASSIFICADOR_N8N_WEBHOOK_URL="http://localhost:5678/webhook/classificador"
